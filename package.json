{
  "name": "scam-detector",
  "version": "0.1.0",
  "description": "Detecte les signaux d'une fausse plateforme d'investissement ou de gains en ligne (zone UEMOA) a partir d'une URL : agrement BCEAO, domaine, discours, signaux techniques. Rend un verdict argumente.",
  "type": "module",
  "bin": {
    "scam-detector": "dist/src/cli.js"
  },
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "tsc -p .",
    "scan": "npm run build && node dist/src/cli.js",
    "serve": "npm run build && node dist/src/server.js",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\""
  },
  "keywords": ["scam", "fraud", "investment", "uemoa", "bceao", "security", "osint"],
  "author": "CREZZUSS",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.3"
  }
}
